<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Ebir.Mes.Api</RootNamespace>
    <FrontendDist>$(MSBuildProjectDirectory)\..\..\frontend\dist</FrontendDist>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ebir.Mes.Application\Ebir.Mes.Application.csproj" />
    <ProjectReference Include="..\Ebir.Mes.Infrastructure\Ebir.Mes.Infrastructure.csproj" />
    <ProjectReference Include="..\Ebir.Mes.Integrations\Ebir.Mes.Integrations.csproj" />
  </ItemGroup>
  <Target Name="IncludeFrontendInPublish" AfterTargets="ComputeFilesToPublish">
    <Error
      Condition="!Exists('$(FrontendDist)\index.html')"
      Text="Frontend dist not found. Run npm run build in src/frontend before publishing the API." />
    <ItemGroup>
      <FrontendPublishFiles Include="$(FrontendDist)\**\*" />
      <ResolvedFileToPublish
        Include="@(FrontendPublishFiles->'%(FullPath)')"
        Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
